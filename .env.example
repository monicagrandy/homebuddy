# Core model settings
OPENAI_MODEL=
OPENAI_WORKFLOW_MODEL=gpt-6-sol
TESTING_OPENAI_MODEL=
OPENAI_MAX_RETRIES=2
OPENAI_API_KEY=""

# Local demo / dev defaults
DEMO_SESSION_ID=demo-session
TAVILY_API_KEY=""
BACKEND_URL=http://backend:8000

# Cognito
COGNITO_APP_CLIENT_ID=""
COGNITO_APP_CLIENT_SECRET=""
# Comma-separated public app clients for the native apps (no secret, auth code + PKCE).
COGNITO_MOBILE_APP_CLIENT_IDS=""
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=""
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/user-pool-id
COGNITO_JWKS_URL=https://cognito-idp.us-east-2.amazonaws.com/user-pool-id/.well-known/jwks.json
COGNITO_DOMAIN=https://us-east-2nsnhvetbq.auth.us-east-2.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:8501
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:8501
COGNITO_ALLOWED_GROUPS=beta-testers
PRESIDIO_SPACY_MODEL=en_core_web_sm
WARM_RUNTIME_ON_STARTUP=true
HOME_OPERATIONS_ENABLED=false

# External providers
CONTRACTOR_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=""
SERPAPI_API_URL=https://serpapi.com/search
CONTRACTOR_SUGGESTION_LIMIT=3
CONTRACTOR_SEARCH_MONTHLY_LIMIT=10

# Persistence
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/home_buddy
VECTOR_STORE_PROVIDER=pgvector
POSTGRES_DB=home_buddy
POSTGRES_USER=homebuddy
POSTGRES_PASSWORD=""

# LangSmith / tracing
# The backend currently reads LANGCHAIN_TRACING_V2.
# Keep LANGCHAIN_TRACING_V2_TRACING aligned too if you use external tooling that expects it.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_TRACING_V2_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="HomeBuddy"

# Optional deployment metadata
PUBLIC_DOMAIN=""

# Public API
# "production" hides /docs and /openapi.json.
ENVIRONMENT=development
# Host headers the backend answers to (comma-separated); empty allows any.
ALLOWED_HOSTS=""
# Per-user limits; 0 turns a limit off.
RATE_LIMIT_QUERIES_PER_MINUTE=10
RATE_LIMIT_DOCUMENTS_PER_MINUTE=10
# Database connections; each streamed answer holds about two.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Documents
# Background indexing for uploads from the native apps (POST /documents/jobs).
DOCUMENT_JOBS_ENABLED=true
MAX_UPLOAD_MB=50

# Conversations
# Chats with no activity for this many days are deleted (0 keeps them forever).
CONVERSATION_RETENTION_DAYS=90
# Daily housekeeping thread: conversation retention and old indexing-job cleanup.
MAINTENANCE_ENABLED=true
